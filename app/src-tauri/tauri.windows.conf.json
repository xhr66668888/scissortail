{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "windows": {
      "staticVCRuntime": false
    }
  },
  "bundle": {
    "targets": ["nsis"],
    "publisher": "Scissortail contributors",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
